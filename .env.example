# Databricks — either naming style works

# Option A (Studio / Statement API style)
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_WAREHOUSE_ID=abc123warehouseid

# Option B (SQL connector style — what many Cursor .env.local files already use)
DATABRICKS_SERVER_HOSTNAME=your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/abc123warehouseid
DATABRICKS_TOKEN=dapi...

# Optional overrides
DATABRICKS_CATALOG=revops
DATABRICKS_SCHEMA=pt_salesforce

# Brandfetch — optional brand prefill (colors, fonts, logos)
# Brand API key stays server-side: https://developers.brandfetch.com
# BRANDFETCH_API_KEY=your_brand_api_bearer_token
# Search client ID is browser-safe (Brandfetch requires client-side search calls)
# NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=your_search_client_id

# Studio assistant (in-app help chat) — at least one provider key required
# Prefers Anthropic when both are set. Override with ASSISTANT_PROVIDER=openai|anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# Optional model override (defaults: claude-sonnet-4-5 / gpt-5.4)
# ASSISTANT_MODEL=claude-sonnet-4-5
# ASSISTANT_PROVIDER=anthropic
